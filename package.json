{
  "name": "my-monorepo3",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run build:backend && turbo run dev",
    "build:backend": "cd apps/backend && npm run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/@strapi",
      "**/@strapi/**"
    ]
  }
}
