{
  "name": "my-monorepo3",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run build:backend && turbo run dev",
    "build:backend": "cd apps/backend && npm run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "**/@strapi",
      "**/@strapi/**"
    ]
  },
  "dependencies": {
    "@next/third-parties": "^16.0.1",
    "@tailwindcss/postcss": "^4.1.16",
    "lucide-react": "^0.548.0",
    "postcss": "^8.5.6"
  }
}
